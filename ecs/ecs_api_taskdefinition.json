{
  "containerDefinitions": [
    {
      "name": "api",
      "image": "%s.dkr.ecr.eu-west-1.amazonaws.com/sysblink-api:prod",
      "essential": true,
      "memoryReservation": 5000,
      "portMappings": [
        {
          "hostPort": 0,
          "protocol": "tcp",
          "containerPort": 80
        }
      ],
      "environment": [
        {
          "name": "APP_SETTINGS",
          "value": "src.config.ProductionConfig"
        },
        {
          "name": "DATABASE_TEST_URL",
          "value": "postgres://postgres:postgres@api-db:5432/api_test"
        },
        {
          "name": "DATABASE_URL",
          "value": "%s"
        },
        {
          "name": "SECRET_KEY",
          "value": "%s"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "sysblink-api-log",
          "awslogs-region": "eu-west-3"
        }
      }
    }
  ],
  "family": "sysblink-api-task-definition"
}

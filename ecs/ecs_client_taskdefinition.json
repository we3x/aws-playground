{
    "containerDefinitions": [
      {
        "name": "client",
        "image": "%s.dkr.ecr.eu-west-1.amazonaws.com/sysblink-client:prod",
        "essential": true,
        "memoryReservation": 300,
        "portMappings": [
          {
            "hostPort": 0,
            "protocol": "tcp",
            "containerPort": 80
          }
        ],
        "logConfiguration": {
          "logDriver": "awslogs",
          "options": {
            "awslogs-group": "sysblink-client-log",
            "awslogs-region": "eu-west-3"
          }
        }
      }
    ],
    "family": "sysblink-client-task-definition"
  }
  